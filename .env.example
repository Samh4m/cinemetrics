# Cinemetrics environment variable 
# Copy this file to .env and fill in your real values.

# TMDB API credentioals. Get yours at https://www.themoviedb.org/settings/api
# Use the v4 "API Read Access Token" it should be a really long code if you did it right
TMDB_API_TOKEN=your_tmdb_v4_token_here

# Where to write raw ingested data (default: data/raw)
DATA_DIR=data/raw